{
  "name": "@poke/vitest-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./base.d.ts",
      "default": "./base.js"
    },
    "./base": {
      "types": "./base.d.ts",
      "default": "./base.js"
    },
    "./node": {
      "types": "./node.d.ts",
      "default": "./node.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./setup": "./setup.js"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2"
  },
  "devDependencies": {
    "@poke/eslint-config": "workspace:*",
    "@poke/tsconfig": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.17.0",
    "jsdom": "^30.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  }
}
