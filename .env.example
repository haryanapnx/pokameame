# ─────────────────────────────────────────────────────────────────────────────
# Pokemon Explorer — environment variables
#
# Next.js loads .env.local from each app's own directory, so copy this file there
# and fill in the values each app needs:
#
#   cp .env.example apps/shell/.env.local     # POKEMON_ZONE_URL, BERRIES_ZONE_URL
#   cp .env.example apps/pokemon/.env.local   # DATABASE_URL, POKEAPI_BASE_URL, SHELL_ORIGIN
#   cp .env.example apps/berries/.env.local   # DATABASE_URL, POKEAPI_BASE_URL, SHELL_ORIGIN
#
# For CLI migrations, copy it to the repo root as `.env` (pnpm db:migrate loads it):
#
#   cp .env.example .env
#
# Real secrets (.env, .env.local) are gitignored — only this example file is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Zone URLs — used by the `shell` app only ─────────────────────────────────
# The shell proxies /pokemon/* and /berries/* to these via Next `rewrites()`.
# **Origin only** — never include the /pokemon or /berries path, the shell appends it.
#   right: https://pokemon-explorer-pokemon.vercel.app
#   wrong: https://pokemon-explorer-pokemon.vercel.app/pokemon
# Local dev: the port each zone runs on.
# Production: each zone's Vercel deployment URL.
# Read at BUILD time — set these before `pnpm build`, and redeploy the shell after changing them.
POKEMON_ZONE_URL=http://localhost:3001
BERRIES_ZONE_URL=http://localhost:3002

# ── Shell origin — used by the `pokemon` and `berries` apps ──────────────────
# Server Actions post from the shell's origin, so each zone allows it through
# `experimental.serverActions.allowedOrigins`. Defaults to localhost:3000.
# Production: the shell's deployment URL (e.g. https://pokemon-explorer.vercel.app).
SHELL_ORIGIN=http://localhost:3000

# ── Database — used by the `pokemon` and `berries` apps (via @poke/core) ─────
# Neon PostgreSQL connection string. Use the **pooled** endpoint (its host contains
# `-pooler`) and keep `sslmode=require`.
# Neon dashboard → Connection Details → Connection pooling → Node.js / pg.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# ── Upstream API — optional, used by @poke/core ──────────────────────────────
# Override only to point at a mock or proxy. Defaults to the public PokeAPI.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
